<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SandMarkDown.Distribution</RootNamespace>
    <AssemblyName>ReleasePlan</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Decides whether a SandMarkDown version change publishes a GitHub Release. No secrets are required.</Description>
  </PropertyGroup>

</Project>
