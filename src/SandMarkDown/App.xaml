<Application x:Class="SandMarkDown.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <!--
      Style: sandmark-app
      Theme: dark by default. View, Dark mode switches to the light palette in App.ApplyTheme.
      Tokens: docs/tokens.css
    -->
    <Application.Resources>
        <FontFamily x:Key="SmtFont">Segoe UI, system-ui, sans-serif</FontFamily>
        <FontFamily x:Key="SmtMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

        <SolidColorBrush x:Key="SmtPage" Color="#FF101418"/>
        <SolidColorBrush x:Key="SmtInk" Color="#FFE7EEF3"/>
        <SolidColorBrush x:Key="SmtMuted" Color="#FF9AA6B2"/>
        <SolidColorBrush x:Key="SmtSurface" Color="#FF1A2129"/>
        <SolidColorBrush x:Key="SmtLine" Color="#FF2C3642"/>
        <SolidColorBrush x:Key="SmtAccent" Color="#FF8EC0E0"/>
        <SolidColorBrush x:Key="SmtAccentInk" Color="#FF8EC0E0"/>
        <SolidColorBrush x:Key="SmtOnAccent" Color="#FF101418"/>
        <SolidColorBrush x:Key="SmtDanger" Color="#FFF0A8A8"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#FFA9D0E8"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource SmtFont}"/>
            <Setter Property="Background" Value="{DynamicResource SmtPage}"/>
            <Setter Property="Foreground" Value="{DynamicResource SmtInk}"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource SmtSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource SmtInk}"/>
            <Setter Property="FontFamily" Value="{DynamicResource SmtFont}"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource SmtInk}"/>
            <Setter Property="Background" Value="{DynamicResource SmtSurface}"/>
            <Setter Property="FontFamily" Value="{DynamicResource SmtFont}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SmtMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SmtAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SmtOnAccent}"/>
            <Setter Property="FontFamily" Value="{DynamicResource SmtFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <FontFamily x:Key="SmtIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SmtMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource SmtIcons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SmtLine}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SmtInk}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SmtLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SmtAccentInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource SmtFont}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tb"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tb" Property="Foreground" Value="{DynamicResource SmtAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
