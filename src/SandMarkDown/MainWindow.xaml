<Window x:Class="SandMarkDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SandMarkDown"
        Height="860"
        Width="1100"
        MinHeight="480"
        MinWidth="720"
        Background="{DynamicResource SmtPage}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/favicon.ico"
        AllowDrop="True"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        DragOver="OnDragOver"
        Drop="OnDrop">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenClick" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open _Folder..." Click="OnOpenFolderClick"/>
                <MenuItem x:Name="RecentMenuItem" Header="Open _Recent"/>
                <MenuItem x:Name="CloseMenuItem" Header="_Close" Click="OnCloseClick" InputGestureText="Ctrl+W" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Print..." Click="OnPrintClick" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="BackMenuItem" Header="_Back" Click="OnBackClick" InputGestureText="Alt+Left" IsEnabled="False"/>
                <MenuItem x:Name="ForwardMenuItem" Header="For_ward" Click="OnForwardClick" InputGestureText="Alt+Right" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Find..." Click="OnFindClick" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem x:Name="ExplorerMenuItem" Header="_Explorer" IsCheckable="True" Click="OnViewOptionClick" InputGestureText="Ctrl+Shift+E"/>
                <MenuItem x:Name="PreviewMenuItem" Header="_Preview" IsCheckable="True" Click="OnViewOptionClick"/>
                <MenuItem x:Name="SidebarMenuItem" Header="_Sidebar" IsCheckable="True" Click="OnViewOptionClick"/>
                <MenuItem x:Name="DarkModeMenuItem" Header="_Dark mode" IsCheckable="True" Click="OnViewOptionClick"/>
                <Separator/>
                <MenuItem Header="Zoom _In" Click="OnZoomInClick" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom _Out" Click="OnZoomOutClick" InputGestureText="Ctrl+-"/>
                <MenuItem Header="_Actual Size" Click="OnZoomResetClick" InputGestureText="Ctrl+0"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Set as _Default for Markdown..." Click="OnSetDefaultClick"/>
                <Separator/>
                <MenuItem Header="_About SandMarkDown..." Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SmtSurface}"
                BorderBrush="{DynamicResource SmtLine}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="ZoomText"
                           DockPanel.Dock="Right"
                           Text="100%"
                           AutomationProperties.Name="Zoom level"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SmtMuted}"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource SmtInk}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.Name="Status"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Ready"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource SmtSurface}"
                    BorderBrush="{DynamicResource SmtLine}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,6,2">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72C;"
                                ToolTip="Refresh"
                                AutomationProperties.Name="Refresh Explorer"
                                Click="OnExplorerRefreshClick"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE8DA;"
                                ToolTip="Open folder"
                                AutomationProperties.Name="Open folder"
                                Click="OnOpenFolderClick"/>
                        <TextBlock Text="EXPLORER"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SmtMuted}"/>
                    </DockPanel>
                    <TextBlock x:Name="ExplorerFolderText"
                               DockPanel.Dock="Top"
                               Margin="12,2,8,6"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SmtInk}"/>
                    <TextBlock x:Name="ExplorerEmptyText"
                               DockPanel.Dock="Top"
                               Margin="12,4,12,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SmtMuted}"
                               Text="Open a file or a folder to browse its Markdown files."/>
                    <TreeView x:Name="ExplorerTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource SmtInk}"
                              AutomationProperties.Name="Markdown files"
                              PreviewMouseLeftButtonUp="OnExplorerClick"
                              KeyDown="OnExplorerKeyDown"/>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter"
                          Grid.Column="1"
                          Width="4"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnExplorerResized"/>

            <wv2:WebView2 x:Name="Viewer"
                          Grid.Column="2"
                          AutomationProperties.Name="Document" />
        </Grid>
    </DockPanel>
</Window>
