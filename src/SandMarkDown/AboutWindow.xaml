<Window x:Class="SandMarkDown.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SandMarkDown"
        Height="360"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SmtPage}"
        KeyDown="OnWindowKeyDown">
    <Border Margin="24"
            Background="{DynamicResource SmtSurface}"
            BorderBrush="{DynamicResource SmtLine}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Close"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0"
                        MinWidth="88"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnCloseClick"/>
            </StackPanel>

            <StackPanel>
                <Image Source="pack://application:,,,/Assets/logo-small-narrow.jpg"
                       Height="56"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,16"/>
                <TextBlock x:Name="ProductNameText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SmtInk}"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="CompanyText"
                           FontSize="14"
                           Foreground="{DynamicResource SmtMuted}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="VersionText"
                           FontSize="13"
                           Foreground="{DynamicResource SmtMuted}"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="DescriptionText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SmtInk}"
                           Margin="0,0,0,16"/>
                <Button x:Name="WebsiteButton"
                        Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="OnWebsiteClick"/>
                <TextBlock x:Name="CopyrightText"
                           FontSize="12"
                           Foreground="{DynamicResource SmtMuted}"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
