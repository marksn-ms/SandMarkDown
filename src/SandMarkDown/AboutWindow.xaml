<Window x:Class="SandMarkDown.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="About SandMarkDown"
        Height="660"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SmtPage}"
        Icon="pack://application:,,,/Assets/favicon.ico"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <wv2:WebView2 x:Name="Page" DefaultBackgroundColor="#101418"/>

        <Border x:Name="CanyonCard"
                Visibility="Collapsed"
                Margin="24"
                Padding="12"
                Background="{DynamicResource SmtSurface}"
                BorderBrush="{DynamicResource SmtLine}"
                BorderThickness="1"
                CornerRadius="6">
            <DockPanel>
                <TextBlock x:Name="CanyonStatus"
                           DockPanel.Dock="Bottom"
                           Margin="4,10,4,0"
                           Foreground="{DynamicResource SmtMuted}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Left and Right steer. Esc returns."/>
                <Viewbox x:Name="CanyonHost" Focusable="True" Stretch="Uniform">
                    <TextBlock x:Name="CanyonView"
                               FontFamily="{StaticResource SmtMono}"
                               FontSize="16"
                               LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource SmtAccent}"
                               TextOptions.TextFormattingMode="Display"/>
                </Viewbox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
