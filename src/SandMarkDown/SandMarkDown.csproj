<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Product>SandMarkDown</Product>
    <Company>Sandmark Technologies</Company>
    <Authors>Sandmark Technologies</Authors>
    <Copyright>Copyright © 2026 Sandmark Technologies</Copyright>
    <Description>Local Markdown reader.</Description>
    <!-- Product version. An increase merged to main publishes the GitHub Release. See docs/Distribution.md. -->
    <Version>1.0.0</Version>
    <StartupObject>SandMarkDown.App</StartupObject>
    <!-- ThemeMode is the supported way to get a dark window chrome. The SDK still marks it experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\favicon.ico" />
    <Resource Include="Assets\logo-icon.jpg" />
    <Resource Include="Assets\logo-small-narrow.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SandMarkDown.Core\SandMarkDown.Core.csproj" />
  </ItemGroup>

</Project>
